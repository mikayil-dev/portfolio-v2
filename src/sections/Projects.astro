---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import External from '~icons/lucide/external-link';
import GitHub from '~icons/bytesize/github';

const allProjects = await getCollection('projects');
const projects = allProjects.filter((project) => project.data.highlight);
---

<section id="projects">
  <h2 class="section-heading animate bottom">Projects</h2>

  <div class="projects">
    {
      projects.map((project, i) => (
        <div class="project animate bottom">
          <div class={`img-container animate ${i % 2 ? 'right' : 'left'}`}>
            {project.data.cover && (
              <Image src={project.data.cover} alt={project.data.coverAlt} />
            )}
          </div>

          <div class={`text-container animate ${i % 2 ? 'left' : 'right'}`}>
            <p class="eyebrow">Featured Project</p>

            <h3>{project.data.title}</h3>

            <p class="description">{project.data.description}</p>

            <div class="technologies">
              {project.data.technologies.map((tech) => (
                <div class="tech">{tech}</div>
              ))}
            </div>

            <div class="links">
              {project.data.externalLink && (
                <a
                  href={project.data.externalLink}
                  class="main-button"
                  title="Visit the live project (external link)"
                  target="_blank"
                >
                  <External /> Visit Live
                </a>
              )}

              {project.data.githubLink && (
                <a
                  href={project.data.githubLink}
                  target="_blank"
                  class="main-button"
                  title="Visit Github Repo"
                >
                  <GitHub />
                  Code
                </a>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style lang="scss">
  section {
    .projects {
      display: flex;
      flex-direction: column;
      gap: 80px;

      .project {
        display: flex;
        align-items: center;
        position: relative;
        min-height: 360px;
        padding: 28px;
        border: 1px solid var(--color-line);
        border-radius: calc(var(--radius-panel) + 4px);
        background: var(--color-surface-elevated);
        box-shadow: var(--shadow-elevated);
        backdrop-filter: blur(10px);

        @include view-tablet-s {
          flex-direction: column !important;
          gap: 40px;
        }

        @include view-mobile {
          padding: 20px;
        }

        &:nth-child(2n) {
          flex-direction: row-reverse;

          .text-container {
            margin-left: 0;
            margin-right: auto;
            text-align: start;
            align-items: flex-start;

            .technologies {
              justify-content: flex-start;
            }
          }
        }

        .img-container {
          position: absolute;
          width: 50%;
          border: 1px solid var(--color-line);
          border-radius: calc(var(--radius-panel));
          overflow: hidden;
          box-shadow: var(--shadow-panel);
          background: var(--color-surface);
          display: flex;
          justify-content: center;
          align-items: center;

          @include view-tablet-s {
            position: static;
            width: 100%;
          }

          img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            aspect-ratio: 16 / 10;
            border-radius: calc(var(--radius-panel) + 6px);
            overflow: hidden;
          }
        }

        .text-container {
          width: 50%;
          margin-left: auto;
          text-align: end;
          display: flex;
          flex-direction: column;
          align-items: flex-end;
          z-index: 1;

          @include view-tablet-s {
            width: 100%;
            text-align: start;
            align-items: flex-start;
          }

          .eyebrow {
            width: fit-content;
            margin-bottom: 12px;
            color: var(--primary);
            font-size: 0.875rem;
          }

          h3 {
            max-width: 90%;
            margin-bottom: 20px;
          }

          .description {
            line-height: 1.6;
            color: var(--white);
            font-size: 1rem;
            width: 110%;
            background: var(--color-accent-dark);
            padding: 18px;
            border-radius: var(--radius-panel);
            border: 1px solid var(--color-line);
            backdrop-filter: blur(8px);
            margin-bottom: 20px;

            @include view-tablet-s {
              width: 100%;
            }
          }

          .technologies {
            display: flex;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 24px;
            width: calc(100% - 20px);

            @include view-tablet-s {
              justify-content: flex-start;
            }

            .tech {
              display: block;
              padding: 5px 10px;
              background: var(--color-accent-soft);
              border: 1px solid var(--color-accent-soft-border);
              border-radius: var(--radius-pill);
              font-size: 0.75rem;
              color: var(--color-accent-strong);
            }
          }

          .links {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;

            .main-button {
              font-size: 0.875rem;
              padding: 6px 10px;
            }
          }
        }
      }
    }
  }
</style>
