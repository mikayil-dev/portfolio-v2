---
import GitHub from '~icons/bytesize/github';
import LinkedIn from '~icons/devicon-plain/linkedin';
import X from '~icons/mingcute/social-x-line';
import Rss from '~icons/material-symbols/rss-feed';
import Twitch from '~icons/mdi/twitch';
import Top from '~icons/lucide/arrow-up-from-line';
---

<script>
  const form = document.querySelector('#contact') as HTMLFormElement;
  const formContainer = document.querySelector('footer .form-container');
  const successAlert = document.querySelector('footer .alert-success');
  const errorAlert = document.querySelector('footer .alert-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    // Honeypot check - if filled, silently reject
    if (data.website) {
      formContainer?.classList.add('hide');
      successAlert?.classList.remove('hide');
      return;
    }
    data.subject = 'Kontaktanfrage über Website';

    const EMAIL_API_URL = 'https://email.pikcode.de/api/send';

    try {
      const response = await fetch(EMAIL_API_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        formContainer?.classList.add('hide');
        successAlert?.classList.remove('hide');
        errorAlert?.classList.add('hide');
      } else {
        throw new Error('Failed to send');
      }
    } catch {
      errorAlert?.classList.remove('hide');
      successAlert?.classList.add('hide');
    }
  });
</script>

<footer>
  <div
    class:list={['contact', { 'animate bottom': Astro.url.pathname === '/' }]}
  >
    <h2 class="animate left">
      <span> Want to work with me? </span>

      <button
        class="main-button animate right"
        title="Scroll back to top"
        onclick="window.scrollTo(0, 0);"
      >
        <Top />
        Back to top
      </button>
    </h2>

    <div class="bottom">
      <form id="contact">
        <p
          class:list={[
            'top-text',
            { 'animate right': Astro.url.pathname === '/' },
          ]}
        >
          Shoot me a message anytime!<br />
          I'm always open to discuss new opportunities, a full-time position or a
          potential project.
        </p>

        <div class="form-container">
          <div class="input-container">
            <label for="name">Name</label>
            <input
              type="text"
              required
              name="name"
              id="name"
              placeholder="John Doe"
            />
          </div>

          <div class="input-container">
            <label for="email">E-mail</label>
            <input
              type="email"
              required
              name="email"
              id="email"
              placeholder="john.doe@example.org"
            />
          </div>

          <div class="input-container">
            <label for="phone">Tel. (optional)</label>
            <input
              type="tel"
              name="phone"
              id="phone"
              placeholder="+49 176 123123 01"
            />
          </div>

          <div class="input-container">
            <label for="message">Message</label>
            <textarea
              name="message"
              id="message"
              placeholder="Your message"
              rows="3"></textarea>
          </div>

          <div class="check-container">
            <label for="privacy">
              I consent to the processing of the information provided in this
              contact form for the purpose of responding to my inquiry via
              email.
            </label>

            <input type="checkbox" required name="privacy" id="privacy" />
          </div>

          <div class="website-field" aria-hidden="true">
            <label for="website">Website</label>
            <input
              type="text"
              id="website"
              name="website"
              autocomplete="off"
              tabindex="-1"
            />
          </div>

          <button class="main-button" type="submit">Send message</button>
        </div>

        <div class="alert-success hide">
          <p>Thank you for your message! I'll get back to you shortly.</p>
        </div>

        <div class="alert-error hide">
          <p>An error occured, please try again later.</p>
        </div>
      </form>

      <div
        class:list={['links', { 'animate right': Astro.url.pathname === '/' }]}
      >
        <h3>Social</h3>

        <div class="links-container">
          <a
            href="https://twitch.tv/miki_devs"
            title="Visit my Twitch profile"
            target="_blank"
          >
            <Twitch />
          </a>

          <a
            href="https://x.com/mikayil_dev"
            title="Visit my X profile"
            target="_blank"
          >
            <X />
          </a>

          <a
            href="https://github.com/mikayil-dev"
            title="Visit my GitHub profile"
            target="_blank"
          >
            <GitHub />
          </a>

          <a
            href="https://www.linkedin.com/in/mikayilgx/"
            title="Visit my LinkedIn profile"
            target="_blank"
          >
            <LinkedIn />
          </a>

          <a href="/rss.xml" title="Subscribe to my RSS feed">
            <Rss />
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="end-bar animate bottom">
    <p class="copyright animate left">
      &copy; {new Date().getFullYear()} Mikayil Gacek<span class="cursor">
      </span>
    </p>
  </div>
</footer>

<style lang="scss">
  .hide {
    display: none !important;
  }

  footer {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--section-padding);
    padding-top: 0;
    margin-top: 80px;

    .contact {
      padding: var(--section-padding);
      padding-left: 0;
      padding-right: 0;
      padding-bottom: 0;
      border-top: 1px solid var(--primary);
      margin-bottom: 60px;

      @include view-mobile {
        margin-bottom: 40px;
      }

      h2 {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 40px;
        margin-bottom: 32px;

        span {
          max-width: 700px;
        }

        button {
          margin-top: 0.6em;
          white-space: nowrap;
          font-size: 1rem;
          display: flex;
          align-items: center;
          width: fit-content;
        }

        @include view-tablet-s {
          flex-wrap: wrap-reverse;

          button {
            margin: 0;
            margin-left: auto;
          }
        }
      }

      .bottom {
        display: flex;
        align-items: flex-start;
        gap: 40px;
        justify-content: space-between;

        @include view-tablet-s {
          flex-wrap: wrap;
        }

        form {
          display: flex;
          gap: 24px;
          flex-direction: column;
          max-width: 600px;

          .form-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            align-items: flex-start;
            width: 100%;

            .input-container {
              position: relative;
              width: 100%;

              label {
                font-size: 0.85rem;
                position: absolute;
                top: 0;
                left: 12px;
                background-color: var(--background);
                transform: translateY(-50%);
                padding: 0 4px;
              }

              input,
              textarea {
                color: var(--text);
                width: 100%;
                border: 1px solid var(--primary);
                border-radius: 8px;
                padding: 12px;
                background-color: var(--background);
                resize: none;
                line-height: 1.5;
              }

              button {
                width: fit-content;
              }
            }

            .check-container {
              display: flex;
              flex-direction: row-reverse;
              align-items: flex-start;

              input {
                margin-top: 0.25rem;
                margin-right: 8px;
              }

              label {
                font-size: 0.8rem;
                color: var(--gray);
              }
            }

            .website-field {
              position: absolute;
              left: -9999px;
              opacity: 0;
              height: 0;
              overflow: hidden;
              pointer-events: none;
            }
          }

          .alert-success,
          .alert-error {
            margin: 0 auto;
            width: 100%;
            max-width: 600px;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 1.125rem;
            line-height: 1.5;
            text-align: center;
          }

          .alert-success {
            background-color: #22c55e20;
            border: 1px solid #22c55e;
            color: #22c55e;
          }

          .alert-error {
            background-color: #ef444420;
            border: 1px solid #ef4444;
            color: #ef4444;
          }
        }

        .links {
          padding: 12px 20px;
          border: 1px solid var(--primary);
          border-radius: 8px;
          box-shadow: 0 4px 10px #00000055;

          h3 {
            @include h4;
            text-align: end;
            margin-bottom: 12px;

            @include view-mobile {
              text-align: start;
            }
          }

          .links-container {
            display: flex;
            gap: 20px;

            a {
              font-size: 20px;
              transition: 0.2s;
              line-height: 1;

              @include hover {
                color: var(--primary);
              }
            }
          }
        }
      }
    }

    .end-bar {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;

      .copyright {
        .cursor {
          margin-left: 0.2em;
          width: 0.5em;
          height: 1em;
        }
      }

      a {
        text-decoration: underline;
        color: var(--primary);
      }
    }
  }
</style>
